{
  "suite": "egret-of-care-management",
  "root": "..",
  "data_note": "Fictional data in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "egret_check",
      "args": {
        "time": "fixtures/time-log.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.patient_months": 7,
          "result.patients": 7,
          "result.dollars_at_risk": 287,
          "result.dollars_unbilled": 107
        }
      }
    },
    {
      "id": "every-planted-status-in-order",
      "tool": "egret_check",
      "args": {
        "time": "fixtures/time-log.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "no_consent",
          "result.items.1.status": "other_practice",
          "result.items.2.status": "overlap_codes",
          "result.items.3.status": "under_threshold",
          "result.items.4.status": "addon_over",
          "result.items.5.status": "unbilled_time"
        }
      }
    },
    {
      "id": "status-filter",
      "tool": "egret_check",
      "args": {
        "time": "fixtures/time-log.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10",
        "status": "no_consent"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.items.0.status": "no_consent"
        }
      }
    },
    {
      "id": "limit-one",
      "tool": "egret_check",
      "args": {
        "time": "fixtures/time-log.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10",
        "limit": 1
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.items": 1
        }
      }
    },
    {
      "id": "report",
      "tool": "egret_write_report",
      "args": {
        "time": "fixtures/time-log.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10"
      },
      "expect": {
        "status": "executed",
        "matches": [
          "\\.csv",
          "\\.html"
        ]
      }
    },
    {
      "id": "report-spanish",
      "tool": "egret_write_report",
      "args": {
        "time": "fixtures/time-log.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10",
        "language": "es"
      },
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "typo-setting-refused",
      "tool": "egret_check",
      "args": {
        "time": "fixtures/time-log.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings-typo.json",
        "month": "2026-10"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "missing-file",
      "tool": "egret_check",
      "args": {
        "time": "fixtures/does-not-exist.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "refuses-claim_submit",
      "tool": "claim_submit",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-patient_call",
      "tool": "patient_call",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "egret_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty"
        ]
      }
    },
    {
      "id": "addon-supported",
      "tool": "egret_check",
      "args": {
        "time": "fixtures/time-log.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10",
        "status": "addon_over"
      },
      "expect": {
        "equals": {
          "result.items.0.minutes": 45,
          "result.items.0.supported": 1,
          "result.items.0.units": 2
        }
      }
    },
    {
      "id": "unbilled-supports",
      "tool": "egret_check",
      "args": {
        "time": "fixtures/time-log.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10",
        "status": "unbilled_time"
      },
      "expect": {
        "equals": {
          "result.items.0.supports": "99490×1 99439×1",
          "result.items.0.minutes": 40
        }
      }
    },
    {
      "id": "other-month-empty",
      "tool": "egret_check",
      "args": {
        "time": "fixtures/time-log.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-09"
      },
      "expect": {
        "equals": {
          "result.patient_months": 0
        }
      }
    },
    {
      "id": "bad-month",
      "tool": "egret_check",
      "args": {
        "time": "fixtures/time-log.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "October"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "egret_check",
      "args": {
        "time": "../../outside-root.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "egret_check",
      "args": {
        "time": "fixtures/missing-export.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
