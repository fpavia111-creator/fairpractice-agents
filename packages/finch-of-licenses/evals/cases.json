{
 "suite": "finch-of-licenses",
 "root": "..",
 "data_note": "Fictional data in ../fixtures. Deterministic checks; no model is called.",
 "cases": [
  {
   "id": "totals",
   "tool": "finch_check",
   "args": {
    "credentials": "fixtures/credentials.csv",
    "roster": "fixtures/roster.csv",
    "shifts": "fixtures/shifts.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "executed",
    "equals": {
     "result.people": 6,
     "result.credentials": 13,
     "result.shifts_checked": 6
    }
   }
  },
  {
   "id": "every-planted-status-in-order",
   "tool": "finch_check",
   "args": {
    "credentials": "fixtures/credentials.csv",
    "roster": "fixtures/roster.csv",
    "shifts": "fixtures/shifts.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "equals": {
     "result.items.0.status": "worked_expired",
     "result.items.1.status": "expired",
     "result.items.2.status": "missing_required",
     "result.items.3.status": "wrong_state",
     "result.items.4.status": "expiring_soon",
     "result.items.5.status": "never_verified",
     "result.items.6.status": "verification_stale"
    }
   }
  },
  {
   "id": "status-filter",
   "tool": "finch_check",
   "args": {
    "credentials": "fixtures/credentials.csv",
    "roster": "fixtures/roster.csv",
    "shifts": "fixtures/shifts.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "worked_expired"
   },
   "expect": {
    "status": "executed",
    "equals": {
     "result.items.0.status": "worked_expired"
    }
   }
  },
  {
   "id": "limit-one",
   "tool": "finch_check",
   "args": {
    "credentials": "fixtures/credentials.csv",
    "roster": "fixtures/roster.csv",
    "shifts": "fixtures/shifts.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "limit": 1
   },
   "expect": {
    "status": "executed",
    "length": {
     "result.items": 1
    }
   }
  },
  {
   "id": "report",
   "tool": "finch_write_report",
   "args": {
    "credentials": "fixtures/credentials.csv",
    "roster": "fixtures/roster.csv",
    "shifts": "fixtures/shifts.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "executed",
    "matches": [
     "\\.csv",
     "\\.html"
    ]
   }
  },
  {
   "id": "report-spanish",
   "tool": "finch_write_report",
   "args": {
    "credentials": "fixtures/credentials.csv",
    "roster": "fixtures/roster.csv",
    "shifts": "fixtures/shifts.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "language": "es"
   },
   "expect": {
    "status": "executed"
   }
  },
  {
   "id": "typo-setting-refused",
   "tool": "finch_check",
   "args": {
    "credentials": "fixtures/credentials.csv",
    "roster": "fixtures/roster.csv",
    "shifts": "fixtures/shifts.csv",
    "settings": "fixtures/settings-typo.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "error"
   }
  },
  {
   "id": "missing-file",
   "tool": "finch_check",
   "args": {
    "credentials": "fixtures/does-not-exist.csv",
    "roster": "fixtures/roster.csv",
    "shifts": "fixtures/shifts.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "error"
   }
  },
  {
   "id": "refuses-schedule_remove",
   "tool": "schedule_remove",
   "args": {},
   "expect": {
    "status": "blocked"
   }
  },
  {
   "id": "refuses-board_report_submit",
   "tool": "board_report_submit",
   "args": {},
   "expect": {
    "status": "blocked"
   }
  },
  {
   "id": "recall-empty-memory",
   "tool": "finch_recall",
   "args": {},
   "expect": {
    "status": "executed",
    "contains": [
     "memory is empty"
    ]
   }
  },
  {
   "id": "shifts-after-expiry",
   "tool": "finch_check",
   "args": {
    "credentials": "fixtures/credentials.csv",
    "roster": "fixtures/roster.csv",
    "shifts": "fixtures/shifts.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "worked_expired"
   },
   "expect": {
    "equals": {
     "result.items.0.shifts": 3,
     "result.items.0.first_shift": "2026-11-02",
     "result.items.0.expires": "2026-10-31"
    }
   }
  },
  {
   "id": "without-shifts-it-is-expired",
   "tool": "finch_check",
   "args": {
    "credentials": "fixtures/credentials.csv",
    "roster": "fixtures/roster.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "equals": {
     "result.by_status.expired": 2
    },
    "not_contains": [
     "\"worked_expired\""
    ]
   }
  },
  {
   "id": "compact-license-covers-texas",
   "tool": "finch_check",
   "args": {
    "credentials": "fixtures/credentials.csv",
    "roster": "fixtures/roster.csv",
    "shifts": "fixtures/shifts.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "wrong_state"
   },
   "expect": {
    "length": {
     "result.items": 1
    },
    "equals": {
     "result.items.0.state": "CA",
     "result.items.0.work_state": "TX"
    }
   }
  },
  {
   "id": "no-settings-no-required-check",
   "tool": "finch_check",
   "args": {
    "credentials": "fixtures/credentials.csv",
    "roster": "fixtures/roster.csv",
    "shifts": "fixtures/shifts.csv",
    "as_of": "2026-11-15"
   },
   "expect": {
    "equals": {},
    "not_contains": [
     "\"missing_required\"",
     "\"wrong_state\""
    ]
   }
  },
  {
   "id": "terminated-staff-skipped",
   "tool": "finch_check",
   "args": {
    "credentials": "fixtures/credentials.csv",
    "roster": "fixtures/roster.csv",
    "shifts": "fixtures/shifts.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "equals": {
     "result.people": 6
    }
   }
  }
 ]
}