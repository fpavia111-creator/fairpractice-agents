{
  "suite": "fairpractice-capitation",
  "root": "..",
  "data_note": "Fictional data in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "capitation_check",
      "args": {
        "roster": "fixtures/member-roster.csv",
        "payments": "fixtures/cap-payments.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.members": 7,
          "result.expected": 640,
          "result.paid": 695,
          "result.to_dispute": 41,
          "result.to_set_aside": 96,
          "result.net": -55
        }
      }
    },
    {
      "id": "every-planted-status-in-order",
      "tool": "capitation_check",
      "args": {
        "roster": "fixtures/member-roster.csv",
        "payments": "fixtures/cap-payments.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "not_paid",
          "result.items.1.status": "wrong_rate",
          "result.items.2.status": "duplicate_payment",
          "result.items.3.status": "paid_not_eligible",
          "result.items.4.status": "paid_not_eligible",
          "result.items.5.status": "retro_term",
          "result.items.6.status": "retro_add",
          "result.items.7.status": "retro_add"
        }
      }
    },
    {
      "id": "status-filter",
      "tool": "capitation_check",
      "args": {
        "roster": "fixtures/member-roster.csv",
        "payments": "fixtures/cap-payments.csv",
        "settings": "fixtures/settings.json",
        "status": "not_paid"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.items.0.status": "not_paid"
        }
      }
    },
    {
      "id": "limit-one",
      "tool": "capitation_check",
      "args": {
        "roster": "fixtures/member-roster.csv",
        "payments": "fixtures/cap-payments.csv",
        "settings": "fixtures/settings.json",
        "limit": 1
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.items": 1
        }
      }
    },
    {
      "id": "report",
      "tool": "capitation_write_report",
      "args": {
        "roster": "fixtures/member-roster.csv",
        "payments": "fixtures/cap-payments.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "executed",
        "matches": [
          "\\.csv",
          "\\.html"
        ]
      }
    },
    {
      "id": "report-spanish",
      "tool": "capitation_write_report",
      "args": {
        "roster": "fixtures/member-roster.csv",
        "payments": "fixtures/cap-payments.csv",
        "settings": "fixtures/settings.json",
        "language": "es"
      },
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "typo-setting-refused",
      "tool": "capitation_check",
      "args": {
        "roster": "fixtures/member-roster.csv",
        "payments": "fixtures/cap-payments.csv",
        "settings": "fixtures/settings-typo.json"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "missing-file",
      "tool": "capitation_check",
      "args": {
        "roster": "fixtures/member-roster.csv",
        "payments": "fixtures/does-not-exist.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "refuses-dispute_submit",
      "tool": "dispute_submit",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-refund_send",
      "tool": "refund_send",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "capitation_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty"
        ]
      }
    },
    {
      "id": "wrong-rate-detail",
      "tool": "capitation_check",
      "args": {
        "roster": "fixtures/member-roster.csv",
        "payments": "fixtures/cap-payments.csv",
        "settings": "fixtures/settings.json",
        "status": "wrong_rate"
      },
      "expect": {
        "equals": {
          "result.items.0.expected": 55,
          "result.items.0.paid": 32,
          "result.items.0.category": "Senior"
        }
      }
    },
    {
      "id": "october-only",
      "tool": "capitation_check",
      "args": {
        "roster": "fixtures/member-roster.csv",
        "payments": "fixtures/cap-payments.csv",
        "settings": "fixtures/settings.json",
        "from": "2026-10",
        "to": "2026-10"
      },
      "expect": {
        "equals": {
          "result.months.0": "2026-10",
          "result.to_dispute": 23
        },
        "not_contains": [
          "\"not_paid\""
        ]
      }
    },
    {
      "id": "no-rates-no-rate-check",
      "tool": "capitation_check",
      "args": {
        "roster": "fixtures/member-roster.csv",
        "payments": "fixtures/cap-payments.csv"
      },
      "expect": {
        "equals": {
          "result.by_status.not_paid": 1
        },
        "not_contains": [
          "\"wrong_rate\""
        ]
      }
    },
    {
      "id": "member-id-masked",
      "tool": "capitation_check",
      "args": {
        "roster": "fixtures/member-roster.csv",
        "payments": "fixtures/cap-payments.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "not_contains": [
          "CM2004"
        ]
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "capitation_check",
      "args": {
        "roster": "../../outside-root.csv",
        "payments": "fixtures/cap-payments.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "capitation_check",
      "args": {
        "roster": "fixtures/missing-export.csv",
        "payments": "fixtures/cap-payments.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
