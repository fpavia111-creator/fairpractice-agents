{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/fairpractice-code-updates",
  "title": "Fairpractice Code Updates",
  "description": "Code-set update impact: deleted and changed CPT, HCPCS and ICD-10 codes found in your…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairpractice-agents",
    "source": "github",
    "subfolder": "packages/fairpractice-code-updates"
  },
  "websiteUrl": "https://fair-agents.com/fairpractice.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fairpractice-code-updates",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
