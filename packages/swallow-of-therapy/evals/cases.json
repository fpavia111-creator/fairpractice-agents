{
  "suite": "swallow-of-therapy",
  "root": "..",
  "data_note": "Fictional data in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "swallow_check",
      "args": {
        "visits": "fixtures/visits-2026.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.visits": 13,
          "result.patients": 4,
          "result.plans": 4,
          "result.dollars_at_risk": 301.25
        }
      }
    },
    {
      "id": "every-planted-status-in-order",
      "tool": "swallow_check",
      "args": {
        "visits": "fixtures/visits-2026.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "no_plan_of_care",
          "result.items.1.status": "cert_unsigned",
          "result.items.2.status": "eight_minute_over",
          "result.items.3.status": "assistant_modifier_missing",
          "result.items.4.status": "discipline_modifier_wrong",
          "result.items.5.status": "kx_missing",
          "result.items.6.status": "recert_due"
        }
      }
    },
    {
      "id": "status-filter",
      "tool": "swallow_check",
      "args": {
        "visits": "fixtures/visits-2026.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15",
        "status": "no_plan_of_care"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.items.0.status": "no_plan_of_care"
        }
      }
    },
    {
      "id": "limit-one",
      "tool": "swallow_check",
      "args": {
        "visits": "fixtures/visits-2026.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15",
        "limit": 1
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.items": 1
        }
      }
    },
    {
      "id": "report",
      "tool": "swallow_write_report",
      "args": {
        "visits": "fixtures/visits-2026.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "matches": [
          "\\.csv",
          "\\.html"
        ]
      }
    },
    {
      "id": "report-spanish",
      "tool": "swallow_write_report",
      "args": {
        "visits": "fixtures/visits-2026.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15",
        "language": "es"
      },
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "typo-setting-refused",
      "tool": "swallow_check",
      "args": {
        "visits": "fixtures/visits-2026.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings-typo.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "missing-file",
      "tool": "swallow_check",
      "args": {
        "visits": "fixtures/does-not-exist.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "refuses-claim_submit",
      "tool": "claim_submit",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-modifier_apply",
      "tool": "modifier_apply",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "swallow_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty"
        ]
      }
    },
    {
      "id": "eight-minute-detail",
      "tool": "swallow_check",
      "args": {
        "visits": "fixtures/visits-2026.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15",
        "status": "eight_minute_over"
      },
      "expect": {
        "equals": {
          "result.items.0.minutes": 40,
          "result.items.0.allowed_units": 3,
          "result.items.0.over_units": 1
        }
      }
    },
    {
      "id": "kx-detail",
      "tool": "swallow_check",
      "args": {
        "visits": "fixtures/visits-2026.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15",
        "status": "kx_missing"
      },
      "expect": {
        "equals": {
          "result.items.0.year_to_date": 2485,
          "result.items.0.lines": 3,
          "result.items.0.bucket": "PT and speech"
        }
      }
    },
    {
      "id": "assistant-needs-co",
      "tool": "swallow_check",
      "args": {
        "visits": "fixtures/visits-2026.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15",
        "status": "assistant_modifier_missing"
      },
      "expect": {
        "equals": {
          "result.items.0.needed": "CO",
          "result.items.0.cpt": "97530"
        }
      }
    },
    {
      "id": "higher-threshold-no-kx",
      "tool": "swallow_check",
      "args": {
        "visits": "fixtures/visits-2026.csv",
        "plans": "fixtures/plans-of-care.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.by_status.kx_missing": 1,
          "result.by_status.recert_due": 1
        }
      }
    },
    {
      "id": "plans-required",
      "tool": "swallow_check",
      "args": {
        "visits": "fixtures/visits-2026.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "swallow_check",
      "args": {
        "visits": "../../outside-root.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "swallow_check",
      "args": {
        "visits": "fixtures/missing-export.csv",
        "plans": "fixtures/plans-of-care.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
