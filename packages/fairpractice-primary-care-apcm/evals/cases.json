{
  "suite": "fairpractice-primary-care-apcm",
  "root": "..",
  "data_note": "Fictional data in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "apcm_check",
      "args": {
        "patients": "fixtures/apcm-enrolled.csv",
        "claims": "fixtures/claims-2026-10.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.month": "2026-10",
          "result.enrolled": 7,
          "result.billed_patients": 6,
          "result.dollars_at_risk": 175,
          "result.dollars_unbilled": 145
        }
      }
    },
    {
      "id": "every-planted-status-in-order",
      "tool": "apcm_check",
      "args": {
        "patients": "fixtures/apcm-enrolled.csv",
        "claims": "fixtures/claims-2026-10.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "not_enrolled",
          "result.items.1.status": "no_consent",
          "result.items.2.status": "billed_twice",
          "result.items.3.status": "conflict_code",
          "result.items.4.status": "wrong_tier",
          "result.items.5.status": "enrolled_not_billed"
        }
      }
    },
    {
      "id": "status-filter",
      "tool": "apcm_check",
      "args": {
        "patients": "fixtures/apcm-enrolled.csv",
        "claims": "fixtures/claims-2026-10.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10",
        "status": "not_enrolled"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.items.0.status": "not_enrolled"
        }
      }
    },
    {
      "id": "limit-one",
      "tool": "apcm_check",
      "args": {
        "patients": "fixtures/apcm-enrolled.csv",
        "claims": "fixtures/claims-2026-10.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10",
        "limit": 1
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.items": 1
        }
      }
    },
    {
      "id": "report",
      "tool": "apcm_write_report",
      "args": {
        "patients": "fixtures/apcm-enrolled.csv",
        "claims": "fixtures/claims-2026-10.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10"
      },
      "expect": {
        "status": "executed",
        "matches": [
          "\\.csv",
          "\\.html"
        ]
      }
    },
    {
      "id": "report-spanish",
      "tool": "apcm_write_report",
      "args": {
        "patients": "fixtures/apcm-enrolled.csv",
        "claims": "fixtures/claims-2026-10.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10",
        "language": "es"
      },
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "typo-setting-refused",
      "tool": "apcm_check",
      "args": {
        "patients": "fixtures/apcm-enrolled.csv",
        "claims": "fixtures/claims-2026-10.csv",
        "settings": "fixtures/settings-typo.json",
        "month": "2026-10"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "missing-file",
      "tool": "apcm_check",
      "args": {
        "patients": "fixtures/apcm-enrolled.csv",
        "claims": "fixtures/does-not-exist.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "refuses-claim_submit",
      "tool": "claim_submit",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-patient_enroll",
      "tool": "patient_enroll",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "apcm_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty"
        ]
      }
    },
    {
      "id": "tier-under",
      "tool": "apcm_check",
      "args": {
        "patients": "fixtures/apcm-enrolled.csv",
        "claims": "fixtures/claims-2026-10.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10",
        "status": "wrong_tier"
      },
      "expect": {
        "equals": {
          "result.items.0.expected": "G0557",
          "result.items.0.direction": "under",
          "result.items.0.missed": 35
        }
      }
    },
    {
      "id": "conflict-named",
      "tool": "apcm_check",
      "args": {
        "patients": "fixtures/apcm-enrolled.csv",
        "claims": "fixtures/claims-2026-10.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10",
        "status": "conflict_code"
      },
      "expect": {
        "equals": {
          "result.items.0.conflicts": "99490"
        }
      }
    },
    {
      "id": "september-nothing-billed",
      "tool": "apcm_check",
      "args": {
        "patients": "fixtures/apcm-enrolled.csv",
        "claims": "fixtures/claims-2026-10.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-09"
      },
      "expect": {
        "equals": {
          "result.billed_patients": 0,
          "result.by_status.enrolled_not_billed": 5
        }
      }
    },
    {
      "id": "month-required",
      "tool": "apcm_check",
      "args": {
        "patients": "fixtures/apcm-enrolled.csv",
        "claims": "fixtures/claims-2026-10.csv"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "apcm_check",
      "args": {
        "patients": "../../outside-root.csv",
        "claims": "fixtures/claims-2026-10.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "apcm_check",
      "args": {
        "patients": "fixtures/missing-export.csv",
        "claims": "fixtures/claims-2026-10.csv",
        "settings": "fixtures/settings.json",
        "month": "2026-10"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
