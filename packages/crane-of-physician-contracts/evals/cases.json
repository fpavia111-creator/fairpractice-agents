{
 "suite": "crane-of-physician-contracts",
 "root": "..",
 "data_note": "Fictional data in ../fixtures. Deterministic checks; no model is called.",
 "cases": [
  {
   "id": "totals",
   "tool": "crane_check",
   "args": {
    "contracts": "fixtures/agreements.csv",
    "payments": "fixtures/physician-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "executed",
    "equals": {
     "result.contracts": 5,
     "result.payments": 9,
     "result.paid_total": 41100,
     "result.dollars_flagged": 21025
    }
   }
  },
  {
   "id": "every-planted-status-in-order",
   "tool": "crane_check",
   "args": {
    "contracts": "fixtures/agreements.csv",
    "payments": "fixtures/physician-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "equals": {
     "result.items.0.status": "paid_no_contract",
     "result.items.1.status": "signed_after_payment",
     "result.items.2.status": "unsigned_contract",
     "result.items.3.status": "expired_contract_paid",
     "result.items.4.status": "over_annual_cap",
     "result.items.5.status": "rate_above_fmv",
     "result.items.6.status": "no_time_log",
     "result.items.7.status": "expiring_soon",
     "result.items.8.status": "expiring_soon"
    }
   }
  },
  {
   "id": "status-filter",
   "tool": "crane_check",
   "args": {
    "contracts": "fixtures/agreements.csv",
    "payments": "fixtures/physician-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "paid_no_contract"
   },
   "expect": {
    "status": "executed",
    "equals": {
     "result.items.0.status": "paid_no_contract"
    }
   }
  },
  {
   "id": "limit-one",
   "tool": "crane_check",
   "args": {
    "contracts": "fixtures/agreements.csv",
    "payments": "fixtures/physician-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "limit": 1
   },
   "expect": {
    "status": "executed",
    "length": {
     "result.items": 1
    }
   }
  },
  {
   "id": "report",
   "tool": "crane_write_report",
   "args": {
    "contracts": "fixtures/agreements.csv",
    "payments": "fixtures/physician-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "executed",
    "matches": [
     "\\.csv",
     "\\.html"
    ]
   }
  },
  {
   "id": "report-spanish",
   "tool": "crane_write_report",
   "args": {
    "contracts": "fixtures/agreements.csv",
    "payments": "fixtures/physician-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "language": "es"
   },
   "expect": {
    "status": "executed"
   }
  },
  {
   "id": "typo-setting-refused",
   "tool": "crane_check",
   "args": {
    "contracts": "fixtures/agreements.csv",
    "payments": "fixtures/physician-payments-2026.csv",
    "settings": "fixtures/settings-typo.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "error"
   }
  },
  {
   "id": "missing-file",
   "tool": "crane_check",
   "args": {
    "contracts": "fixtures/agreements.csv",
    "payments": "fixtures/does-not-exist.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "error"
   }
  },
  {
   "id": "refuses-payment_release",
   "tool": "payment_release",
   "args": {},
   "expect": {
    "status": "blocked"
   }
  },
  {
   "id": "refuses-self_disclosure_submit",
   "tool": "self_disclosure_submit",
   "args": {},
   "expect": {
    "status": "blocked"
   }
  },
  {
   "id": "recall-empty-memory",
   "tool": "crane_recall",
   "args": {},
   "expect": {
    "status": "executed",
    "contains": [
     "memory is empty"
    ]
   }
  },
  {
   "id": "cap-overage-only",
   "tool": "crane_check",
   "args": {
    "contracts": "fixtures/agreements.csv",
    "payments": "fixtures/physician-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "over_annual_cap"
   },
   "expect": {
    "equals": {
     "result.items.0.at_risk": 1500,
     "result.items.0.year_total": 25500
    }
   }
  },
  {
   "id": "fmv-dollars",
   "tool": "crane_check",
   "args": {
    "contracts": "fixtures/agreements.csv",
    "payments": "fixtures/physician-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "rate_above_fmv"
   },
   "expect": {
    "equals": {
     "result.items.0.at_risk": 625,
     "result.items.0.hourly": 300
    }
   }
  },
  {
   "id": "no-fmv-falls-back-to-contract-rate",
   "tool": "crane_check",
   "args": {
    "contracts": "fixtures/agreements.csv",
    "payments": "fixtures/physician-payments-2026.csv",
    "as_of": "2026-11-15"
   },
   "expect": {
    "equals": {
     "result.by_status.rate_above_contract": 1
    },
    "not_contains": [
     "\"rate_above_fmv\""
    ]
   }
  },
  {
   "id": "no-contract-amount",
   "tool": "crane_check",
   "args": {
    "contracts": "fixtures/agreements.csv",
    "payments": "fixtures/physician-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "paid_no_contract"
   },
   "expect": {
    "equals": {
     "result.items.0.amount": 1500
    }
   }
  },
  {
   "id": "contracts-required",
   "tool": "crane_check",
   "args": {
    "payments": "fixtures/physician-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "error"
   }
  }
 ]
}