{
  "suite": "tern-of-remote-monitoring",
  "root": "..",
  "data_note": "Fictional data in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "tern_check",
      "args": {
        "readings": "fixtures/readings.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.claim_lines": 17,
          "result.patients": 6,
          "result.reading_days": 178,
          "result.dollars_at_risk": 225
        }
      }
    },
    {
      "id": "every-planted-status-in-order",
      "tool": "tern_check",
      "args": {
        "readings": "fixtures/readings.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "setup_repeat",
          "result.items.1.status": "period_overlap",
          "result.items.2.status": "days_short",
          "result.items.3.status": "overlap_rtm",
          "result.items.4.status": "no_interactive",
          "result.items.5.status": "minutes_short"
        }
      }
    },
    {
      "id": "status-filter",
      "tool": "tern_check",
      "args": {
        "readings": "fixtures/readings.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "status": "setup_repeat"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.items.0.status": "setup_repeat"
        }
      }
    },
    {
      "id": "limit-one",
      "tool": "tern_check",
      "args": {
        "readings": "fixtures/readings.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "limit": 1
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.items": 1
        }
      }
    },
    {
      "id": "report",
      "tool": "tern_write_report",
      "args": {
        "readings": "fixtures/readings.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "executed",
        "matches": [
          "\\.csv",
          "\\.html"
        ]
      }
    },
    {
      "id": "report-spanish",
      "tool": "tern_write_report",
      "args": {
        "readings": "fixtures/readings.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "language": "es"
      },
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "typo-setting-refused",
      "tool": "tern_check",
      "args": {
        "readings": "fixtures/readings.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings-typo.json"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "missing-file",
      "tool": "tern_check",
      "args": {
        "readings": "fixtures/does-not-exist.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "refuses-claim_submit",
      "tool": "claim_submit",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-reading_interpret",
      "tool": "reading_interpret",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "tern_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty"
        ]
      }
    },
    {
      "id": "short-days-detail",
      "tool": "tern_check",
      "args": {
        "readings": "fixtures/readings.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "status": "days_short"
      },
      "expect": {
        "equals": {
          "result.items.0.reading_days": 12,
          "result.items.0.supports": "99445",
          "result.items.0.amount": 23
        }
      }
    },
    {
      "id": "overlap-detail",
      "tool": "tern_check",
      "args": {
        "readings": "fixtures/readings.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json",
        "status": "period_overlap"
      },
      "expect": {
        "equals": {
          "result.items.0.other_to": "2026-10-15"
        }
      }
    },
    {
      "id": "no-episodes-still-repeat",
      "tool": "tern_check",
      "args": {
        "readings": "fixtures/readings.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "equals": {
          "result.by_status.setup_repeat": 1
        }
      }
    },
    {
      "id": "claims-required",
      "tool": "tern_check",
      "args": {
        "readings": "fixtures/readings.csv",
        "time": "fixtures/management-time.csv"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "tern_check",
      "args": {
        "readings": "../../outside-root.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "tern_check",
      "args": {
        "readings": "fixtures/missing-export.csv",
        "time": "fixtures/management-time.csv",
        "claims": "fixtures/claims.csv",
        "patients": "fixtures/enrolled.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
