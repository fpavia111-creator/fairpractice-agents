{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/sparrow-of-home-health",
  "title": "Sparrow of Home Health",
  "description": "Home health 30-day periods: notices of admission filed late (with the payment cut per day), visits…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/kestrel-agents",
    "source": "github",
    "subfolder": "packages/sparrow-of-home-health"
  },
  "websiteUrl": "https://fair-agents.com/fairpractice.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "sparrow-of-home-health",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
