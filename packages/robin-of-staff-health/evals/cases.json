{
 "suite": "robin-of-staff-health",
 "root": "..",
 "data_note": "Fictional data in ../fixtures. Deterministic checks; no model is called.",
 "cases": [
  {
   "id": "totals",
   "tool": "robin_check",
   "args": {
    "records": "fixtures/health-records.csv",
    "roster": "fixtures/roster.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "executed",
    "equals": {
     "result.staff": 6,
     "result.requirements": 3,
     "result.out_of_compliance": 4
    }
   }
  },
  {
   "id": "every-planted-status-in-order",
   "tool": "robin_check",
   "args": {
    "records": "fixtures/health-records.csv",
    "roster": "fixtures/roster.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "equals": {
     "result.items.0.status": "new_hire_late",
     "result.items.1.status": "overdue",
     "result.items.2.status": "overdue",
     "result.items.3.status": "declined_no_form",
     "result.items.4.status": "needs_followup",
     "result.items.5.status": "due_soon"
    }
   }
  },
  {
   "id": "status-filter",
   "tool": "robin_check",
   "args": {
    "records": "fixtures/health-records.csv",
    "roster": "fixtures/roster.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "new_hire_late"
   },
   "expect": {
    "status": "executed",
    "equals": {
     "result.items.0.status": "new_hire_late"
    }
   }
  },
  {
   "id": "limit-one",
   "tool": "robin_check",
   "args": {
    "records": "fixtures/health-records.csv",
    "roster": "fixtures/roster.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "limit": 1
   },
   "expect": {
    "status": "executed",
    "length": {
     "result.items": 1
    }
   }
  },
  {
   "id": "report",
   "tool": "robin_write_report",
   "args": {
    "records": "fixtures/health-records.csv",
    "roster": "fixtures/roster.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "executed",
    "matches": [
     "\\.csv",
     "\\.html"
    ]
   }
  },
  {
   "id": "report-spanish",
   "tool": "robin_write_report",
   "args": {
    "records": "fixtures/health-records.csv",
    "roster": "fixtures/roster.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "language": "es"
   },
   "expect": {
    "status": "executed"
   }
  },
  {
   "id": "typo-setting-refused",
   "tool": "robin_check",
   "args": {
    "records": "fixtures/health-records.csv",
    "roster": "fixtures/roster.csv",
    "settings": "fixtures/settings-typo.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "error"
   }
  },
  {
   "id": "missing-file",
   "tool": "robin_check",
   "args": {
    "records": "fixtures/does-not-exist.csv",
    "roster": "fixtures/roster.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "error"
   }
  },
  {
   "id": "refuses-schedule_remove",
   "tool": "schedule_remove",
   "args": {},
   "expect": {
    "status": "blocked"
   }
  },
  {
   "id": "refuses-health_record_send",
   "tool": "health_record_send",
   "args": {},
   "expect": {
    "status": "blocked"
   }
  },
  {
   "id": "recall-empty-memory",
   "tool": "robin_recall",
   "args": {},
   "expect": {
    "status": "executed",
    "contains": [
     "memory is empty"
    ]
   }
  },
  {
   "id": "fit-test-overdue-45-days",
   "tool": "robin_check",
   "args": {
    "records": "fixtures/health-records.csv",
    "roster": "fixtures/roster.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "overdue"
   },
   "expect": {
    "equals": {
     "result.items.0.item": "Fit test",
     "result.items.0.days": 45
    }
   }
  },
  {
   "id": "last-season-flu-is-overdue",
   "tool": "robin_check",
   "args": {
    "records": "fixtures/health-records.csv",
    "roster": "fixtures/roster.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "overdue"
   },
   "expect": {
    "equals": {
     "result.items.1.item": "Flu vaccine",
     "result.items.1.due": "2026-11-01",
     "result.items.1.last_done": "2025-10-01"
    }
   }
  },
  {
   "id": "department-rollup",
   "tool": "robin_check",
   "args": {
    "records": "fixtures/health-records.csv",
    "roster": "fixtures/roster.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "equals": {
     "result.by_department.ICU": 2,
     "result.by_department.Front Desk": 2,
     "result.by_department.Med-Surg": 1
    }
   }
  },
  {
   "id": "no-roster-no-new-hire-check",
   "tool": "robin_check",
   "args": {
    "records": "fixtures/health-records.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "equals": {
     "result.staff": 4
    },
    "not_contains": [
     "\"new_hire_late\""
    ]
   }
  },
  {
   "id": "settings-required",
   "tool": "robin_check",
   "args": {
    "records": "fixtures/health-records.csv",
    "roster": "fixtures/roster.csv",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "error"
   }
  }
 ]
}