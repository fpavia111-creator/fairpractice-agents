{
  "suite": "thrush-of-caregiver-hours",
  "root": "..",
  "data_note": "Fictional data in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "thrush_check",
      "args": {
        "shifts": "fixtures/shifts.csv",
        "payroll": "fixtures/payroll.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.shifts": 14,
          "result.caregivers": 4,
          "result.weeks": 4,
          "result.overtime_hours": 6.67,
          "result.dollars_at_risk": 110.5
        }
      }
    },
    {
      "id": "every-planted-status-in-order",
      "tool": "thrush_check",
      "args": {
        "shifts": "fixtures/shifts.csv",
        "payroll": "fixtures/payroll.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "hours_underpaid",
          "result.items.1.status": "hours_underpaid",
          "result.items.2.status": "meal_break_missed",
          "result.items.3.status": "live_in_sleep",
          "result.items.4.status": "split_shift",
          "result.items.5.status": "travel_time"
        }
      }
    },
    {
      "id": "status-filter",
      "tool": "thrush_check",
      "args": {
        "shifts": "fixtures/shifts.csv",
        "payroll": "fixtures/payroll.csv",
        "settings": "fixtures/settings.json",
        "status": "hours_underpaid"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.items.0.status": "hours_underpaid"
        }
      }
    },
    {
      "id": "limit-one",
      "tool": "thrush_check",
      "args": {
        "shifts": "fixtures/shifts.csv",
        "payroll": "fixtures/payroll.csv",
        "settings": "fixtures/settings.json",
        "limit": 1
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.items": 1
        }
      }
    },
    {
      "id": "report",
      "tool": "thrush_write_report",
      "args": {
        "shifts": "fixtures/shifts.csv",
        "payroll": "fixtures/payroll.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "executed",
        "matches": [
          "\\.csv",
          "\\.html"
        ]
      }
    },
    {
      "id": "report-spanish",
      "tool": "thrush_write_report",
      "args": {
        "shifts": "fixtures/shifts.csv",
        "payroll": "fixtures/payroll.csv",
        "settings": "fixtures/settings.json",
        "language": "es"
      },
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "typo-setting-refused",
      "tool": "thrush_check",
      "args": {
        "shifts": "fixtures/shifts.csv",
        "payroll": "fixtures/payroll.csv",
        "settings": "fixtures/settings-typo.json"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "missing-file",
      "tool": "thrush_check",
      "args": {
        "shifts": "fixtures/does-not-exist.csv",
        "payroll": "fixtures/payroll.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "refuses-payroll_submit",
      "tool": "payroll_submit",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-schedule_change",
      "tool": "schedule_change",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "thrush_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty"
        ]
      }
    },
    {
      "id": "underpaid-travel",
      "tool": "thrush_check",
      "args": {
        "shifts": "fixtures/shifts.csv",
        "payroll": "fixtures/payroll.csv",
        "settings": "fixtures/settings.json",
        "status": "hours_underpaid"
      },
      "expect": {
        "equals": {
          "result.items.0.hours": 46.67,
          "result.items.0.travel_hours": 1.67,
          "result.items.0.amount": 45
        }
      }
    },
    {
      "id": "live-in-counted",
      "tool": "thrush_check",
      "args": {
        "shifts": "fixtures/shifts.csv",
        "payroll": "fixtures/payroll.csv",
        "settings": "fixtures/settings.json",
        "status": "live_in_sleep"
      },
      "expect": {
        "equals": {
          "result.items.0.counted_back": 2
        }
      }
    },
    {
      "id": "no-payroll-lists-overtime",
      "tool": "thrush_check",
      "args": {
        "shifts": "fixtures/shifts.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "equals": {
          "result.by_status.overtime": 1
        },
        "not_contains": [
          "\"hours_underpaid\""
        ]
      }
    },
    {
      "id": "no-settings-no-state-rules",
      "tool": "thrush_check",
      "args": {
        "shifts": "fixtures/shifts.csv",
        "payroll": "fixtures/payroll.csv"
      },
      "expect": {
        "equals": {
          "result.by_status.hours_underpaid": 2
        },
        "not_contains": [
          "\"meal_break_missed\"",
          "\"split_shift\""
        ]
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "thrush_check",
      "args": {
        "shifts": "../../outside-root.csv",
        "payroll": "fixtures/payroll.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "thrush_check",
      "args": {
        "shifts": "fixtures/missing-export.csv",
        "payroll": "fixtures/payroll.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
