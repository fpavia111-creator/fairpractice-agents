{
 "suite": "swift-of-associates",
 "root": "..",
 "data_note": "Fictional data in ../fixtures. Deterministic checks; no model is called.",
 "cases": [
  {
   "id": "totals",
   "tool": "swift_check",
   "args": {
    "vendors": "fixtures/vendors.csv",
    "payments": "fixtures/ap-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "executed",
    "equals": {
     "result.vendors": 7,
     "result.business_associates": 5,
     "result.payments_checked": 7
    }
   }
  },
  {
   "id": "every-planted-status-in-order",
   "tool": "swift_check",
   "args": {
    "vendors": "fixtures/vendors.csv",
    "payments": "fixtures/ap-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "equals": {
     "result.items.0.status": "baa_missing",
     "result.items.1.status": "baa_expired",
     "result.items.2.status": "paid_not_on_list",
     "result.items.3.status": "phi_unknown",
     "result.items.4.status": "never_reviewed",
     "result.items.5.status": "review_overdue",
     "result.items.6.status": "review_overdue",
     "result.items.7.status": "baa_expiring"
    }
   }
  },
  {
   "id": "status-filter",
   "tool": "swift_check",
   "args": {
    "vendors": "fixtures/vendors.csv",
    "payments": "fixtures/ap-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "baa_missing"
   },
   "expect": {
    "status": "executed",
    "equals": {
     "result.items.0.status": "baa_missing"
    }
   }
  },
  {
   "id": "limit-one",
   "tool": "swift_check",
   "args": {
    "vendors": "fixtures/vendors.csv",
    "payments": "fixtures/ap-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "limit": 1
   },
   "expect": {
    "status": "executed",
    "length": {
     "result.items": 1
    }
   }
  },
  {
   "id": "report",
   "tool": "swift_write_report",
   "args": {
    "vendors": "fixtures/vendors.csv",
    "payments": "fixtures/ap-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "executed",
    "matches": [
     "\\.csv",
     "\\.html"
    ]
   }
  },
  {
   "id": "report-spanish",
   "tool": "swift_write_report",
   "args": {
    "vendors": "fixtures/vendors.csv",
    "payments": "fixtures/ap-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "language": "es"
   },
   "expect": {
    "status": "executed"
   }
  },
  {
   "id": "typo-setting-refused",
   "tool": "swift_check",
   "args": {
    "vendors": "fixtures/vendors.csv",
    "payments": "fixtures/ap-payments-2026.csv",
    "settings": "fixtures/settings-typo.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "error"
   }
  },
  {
   "id": "missing-file",
   "tool": "swift_check",
   "args": {
    "vendors": "fixtures/does-not-exist.csv",
    "payments": "fixtures/ap-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "status": "error"
   }
  },
  {
   "id": "refuses-vendor_email_send",
   "tool": "vendor_email_send",
   "args": {},
   "expect": {
    "status": "blocked"
   }
  },
  {
   "id": "refuses-contract_sign",
   "tool": "contract_sign",
   "args": {},
   "expect": {
    "status": "blocked"
   }
  },
  {
   "id": "recall-empty-memory",
   "tool": "swift_recall",
   "args": {},
   "expect": {
    "status": "executed",
    "contains": [
     "memory is empty"
    ]
   }
  },
  {
   "id": "paid-not-listed-total",
   "tool": "swift_check",
   "args": {
    "vendors": "fixtures/vendors.csv",
    "payments": "fixtures/ap-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "paid_not_on_list"
   },
   "expect": {
    "length": {
     "result.items": 1
    },
    "equals": {
     "result.items.0.amount": 3050,
     "result.items.0.payments": 2,
     "result.items.0.last_paid": "2026-09-12"
    }
   }
  },
  {
   "id": "llc-suffix-still-on-list",
   "tool": "swift_check",
   "args": {
    "vendors": "fixtures/vendors.csv",
    "payments": "fixtures/ap-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "not_contains": [
     "Clearpath Billing Partners LLC"
    ]
   }
  },
  {
   "id": "without-settings-utility-and-small-payment-show",
   "tool": "swift_check",
   "args": {
    "vendors": "fixtures/vendors.csv",
    "payments": "fixtures/ap-payments-2026.csv",
    "as_of": "2026-11-15"
   },
   "expect": {
    "equals": {
     "result.by_status.paid_not_on_list": 3
    }
   }
  },
  {
   "id": "no-payments-file",
   "tool": "swift_check",
   "args": {
    "vendors": "fixtures/vendors.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15"
   },
   "expect": {
    "equals": {
     "result.payments_checked": 0
    },
    "not_contains": [
     "\"paid_not_on_list\""
    ]
   }
  },
  {
   "id": "baa-expiring-days",
   "tool": "swift_check",
   "args": {
    "vendors": "fixtures/vendors.csv",
    "payments": "fixtures/ap-payments-2026.csv",
    "settings": "fixtures/settings.json",
    "as_of": "2026-11-15",
    "status": "baa_expiring"
   },
   "expect": {
    "equals": {
     "result.items.0.days": 46
    }
   }
  }
 ],
 "no_names_in_report": true
}