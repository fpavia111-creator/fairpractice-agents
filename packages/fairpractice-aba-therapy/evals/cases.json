{
  "suite": "fairpractice-aba-therapy",
  "root": "..",
  "data_note": "Fictional data in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "aba_check",
      "args": {
        "sessions": "fixtures/sessions-2026-q4.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.sessions": 13,
          "result.clients": 4,
          "result.authorizations": 6,
          "result.dollars_at_risk": 355
        }
      }
    },
    {
      "id": "every-planted-status-in-order",
      "tool": "aba_check",
      "args": {
        "sessions": "fixtures/sessions-2026-q4.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "no_auth",
          "result.items.1.status": "over_auth_total",
          "result.items.2.status": "over_weekly",
          "result.items.3.status": "units_over_minutes",
          "result.items.4.status": "wrong_provider_role",
          "result.items.5.status": "supervision_low",
          "result.items.6.status": "supervision_low",
          "result.items.7.status": "auth_ending_unused"
        }
      }
    },
    {
      "id": "status-filter",
      "tool": "aba_check",
      "args": {
        "sessions": "fixtures/sessions-2026-q4.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15",
        "status": "no_auth"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.items.0.status": "no_auth"
        }
      }
    },
    {
      "id": "limit-one",
      "tool": "aba_check",
      "args": {
        "sessions": "fixtures/sessions-2026-q4.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15",
        "limit": 1
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.items": 1
        }
      }
    },
    {
      "id": "report",
      "tool": "aba_write_report",
      "args": {
        "sessions": "fixtures/sessions-2026-q4.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "matches": [
          "\\.csv",
          "\\.html"
        ]
      }
    },
    {
      "id": "report-spanish",
      "tool": "aba_write_report",
      "args": {
        "sessions": "fixtures/sessions-2026-q4.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15",
        "language": "es"
      },
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "typo-setting-refused",
      "tool": "aba_check",
      "args": {
        "sessions": "fixtures/sessions-2026-q4.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings-typo.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "missing-file",
      "tool": "aba_check",
      "args": {
        "sessions": "fixtures/does-not-exist.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "refuses-claim_submit",
      "tool": "claim_submit",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "refuses-auth_request_submit",
      "tool": "auth_request_submit",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "aba_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty"
        ]
      }
    },
    {
      "id": "weekly-overage",
      "tool": "aba_check",
      "args": {
        "sessions": "fixtures/sessions-2026-q4.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15",
        "status": "over_weekly"
      },
      "expect": {
        "equals": {
          "result.items.0.week_of": "2026-11-02",
          "result.items.0.over_units": 4,
          "result.items.0.date": "2026-11-05"
        }
      }
    },
    {
      "id": "unused-units",
      "tool": "aba_check",
      "args": {
        "sessions": "fixtures/sessions-2026-q4.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15",
        "status": "auth_ending_unused"
      },
      "expect": {
        "equals": {
          "result.items.0.units_left": 288,
          "result.items.0.days": 25
        }
      }
    },
    {
      "id": "stricter-supervision",
      "tool": "aba_check",
      "args": {
        "sessions": "fixtures/sessions-2026-q4.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings-strict.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.by_status.supervision_low": 4
        }
      }
    },
    {
      "id": "no-rates-no-dollars",
      "tool": "aba_check",
      "args": {
        "sessions": "fixtures/sessions-2026-q4.csv",
        "authorizations": "fixtures/authorizations.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.dollars_at_risk": 0,
          "result.by_status.no_auth": 1
        }
      }
    },
    {
      "id": "auths-required",
      "tool": "aba_check",
      "args": {
        "sessions": "fixtures/sessions-2026-q4.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "aba_check",
      "args": {
        "sessions": "../../outside-root.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "aba_check",
      "args": {
        "sessions": "fixtures/missing-export.csv",
        "authorizations": "fixtures/authorizations.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
