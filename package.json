    "check": "node scripts/family-check.mjs",
    "readme": "node scripts/readme.mjs",
    "readme:check": "node scripts/readme.mjs --check",
    "hostile:args": "node scripts/hostile.mjs --args",
    "release:check": "node scripts/release-check.mjs",
    "release:check:offline": "node scripts/release-check.mjs --offline",
    "bench": "node scripts/bench.mjs",
    "intl": "node scripts/intl-check.mjs",
    "accuracy": "node scripts/accuracy.mjs",
    "model-view": "node scripts/model-view.mjs",
    "settings-list": "node scripts/settings-list.mjs",
    "realdata": "node scripts/realdata.mjs",
    "realdata:download": "node scripts/realdata.mjs --download"
