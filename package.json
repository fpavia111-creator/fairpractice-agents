{
  "name": "fairpractice-agents",
  "private": true,
  "description": "Fairpractice: healthcare admin, billing and compliance agents monorepo (30 agents), built on fairclaim-core.",
  "license": "MIT",
  "workspaces": [
    "packages/fairclaim-core",
    "packages/fairpractice-core",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces",
    "evals": "node scripts/run-all-evals.mjs",
    "hostile": "node scripts/hostile.mjs",
